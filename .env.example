# ============================================================
#  复制这份为 .env，再填自己的值。
#  .env 已被 .gitignore 忽略，不会被提交 —— 千万别把真的密码/
#  授权码贴进 .env.example 或 README 里。
# ============================================================

# ---- 账号（必填，就这两行）----
# 任意 IMAP 邮箱都行：QQ / 163 / 126 / Gmail / iCloud / 公司邮箱 …
IMAP_USER=yourname@163.com
# 多数邮箱要用「授权码 / 应用专用密码」，不是登录密码（各家的开法见 README）
IMAP_PASS=

# ---- 服务器（可不填：会按邮箱域名自动识别）----
# 只有自动识别失败时，才需要把下面几行打开手填：
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_SECURE=true
# 也可以直接指定内置预设名（qq、163、126、gmail、icloud、outlook…）：
# IMAP_PROVIDER=

# ---- 可选：AI 简报（只有加 --ai 时才会用到）----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
